<!-- ----  -->
 <%- include('partials/header') %>
    <link rel="stylesheet" href="/css/display.css">
    <%- include('partials/title', {title : 'Display'}) %>
</head>
<body>
    
    <nav>
        <a href="/user">Home</a>
        <a href="/display">Output</a>
    </nav>
    <header>
    </header>
    <main>
         <div class="container">
             <% for(let i = 0; i < userDetails.length; i++) { %>
              <div class="box">
                 <h2>User Details: </h2>
     
                     <p><strong>Name: </strong><%= userDetails[i].name %></p>
                     <p><strong>Email: </strong><%= userDetails[i].email %></p>
                     <p><strong>Number: </strong><%= userDetails[i].number %></p>
                     <p><strong>Password: </strong><%= userDetails[i].password %></p>
                 </div>
             <% } %>
         </div>
    </main>
    
</body>
</html>